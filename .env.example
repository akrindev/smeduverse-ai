# Backend environment variables
GOOGLE_API_KEY=your_google_api_key_here
MCP_SERVER_URL=http://localhost:2222/mcp/smeduverse

# Frontend environment variables (must be prefixed with VITE_)
VITE_API_ENDPOINT=http://localhost:3000/api/chat
VITE_MCP_KEY_ENDPOINT=http://localhost:2222/mcp/key

# Vercel deployment notes:
# - Set GOOGLE_API_KEY in Vercel dashboard (Project Settings > Environment Variables)
# - Set MCP_SERVER_URL to your production MCP server URL
# - VITE_* variables are embedded at build time, update for production:
#   VITE_API_ENDPOINT=/api/chat (relative URL for same-origin)
#   VITE_MCP_KEY_ENDPOINT=https://your-mcp-server.com/mcp/key