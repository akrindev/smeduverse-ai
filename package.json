{
	"name": "smeduverse-ai-agent",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"main": "./dist/smeduverse-ai.umd.js",
	"module": "./dist/smeduverse-ai.es.js",
	"types": "./dist/smeduverse-ai.d.ts",
	"exports": {
		".": {
			"types": "./dist/smeduverse-ai.d.ts",
			"import": "./dist/smeduverse-ai.es.js",
			"require": "./dist/smeduverse-ai.umd.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "bun run --watch server/src/routes/chat.ts & vite --config vite.dev.config.ts",
		"dev:api": "bun run --watch server/src/routes/chat.ts",
		"dev:vercel": "vercel dev",
		"start": "NODE_ENV=production bun run server/src/routes/chat.ts",
		"build": "NODE_ENV=production tsc -b && vite build --mode production",
		"build:widget": "NODE_ENV=production vite build --mode production",
		"build:standalone": "NODE_ENV=production vite build -c vite.cdn.config.ts --mode production",
		"build:demo": "NODE_ENV=production vite build -c vite.dev.config.ts --mode production",
		"build:all": "NODE_ENV=production tsc -b && vite build --mode production && vite build -c vite.cdn.config.ts --mode production && vite build -c vite.dev.config.ts --mode production",
		"deploy": "vercel deploy",
		"deploy:prod": "vercel deploy --prod",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"preview": "vite preview",
		"preview:example": "vite --open examples/standalone.html"
	},
	"dependencies": {
		"@ai-sdk/langchain": "^2.0.3",
		"@ai-sdk/react": "^3.0.3",
		"@langchain/core": "^1.1.8",
		"@langchain/google-genai": "^2.1.3",
		"@langchain/langgraph": "^1.0.7",
		"@langchain/mcp-adapters": "^1.1.1",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-hover-card": "^1.1.15",
		"@radix-ui/react-progress": "^1.1.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@radix-ui/react-use-controllable-state": "^1.2.2",
		"@tailwindcss/vite": "^4.1.18",
		"ai": "^6.0.3",
		"axios": "^1.13.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"embla-carousel-react": "^8.6.0",
		"hono": "^4.11.3",
		"lucide-react": "^0.554.0",
		"marked": "^17.0.1",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"tokenlens": "^1.3.1",
		"use-stick-to-bottom": "^1.1.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@types/bun": "^1.2.14",
		"@types/node": "^25.0.3",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9.39.2",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.26",
		"globals": "^16.5.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.50.1",
		"vite": "npm:rolldown-vite@7.2.5"
	},
	"overrides": {
		"vite": "npm:rolldown-vite@7.2.5",
		"@modelcontextprotocol/sdk": "1.24.0"
	}
}
