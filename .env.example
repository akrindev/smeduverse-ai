# Smeduverse AI Environment Variables

# Google Gemini API Key (required)
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# LangGraph Agent URL (optional, defaults to http://localhost:8123)
# This is the URL of the LangGraph.js agent server started with langgraph-cli
LANGGRAPH_AGENT_URL=http://localhost:8123

# LangSmith API Key (optional, for monitoring and debugging)
# Get your API key from: https://smith.langchain.com/
LANGSMITH_API_KEY=

# MCP Server URL (optional)
# If you have an MCP server for additional tools, specify its URL here
MCP_SERVER_URL=

# Frontend CopilotKit API URL (optional, for Vite frontend)
# Defaults to http://localhost:3000/api/copilotkit
VITE_COPILOTKIT_API_URL=http://localhost:3000/api/copilotkit
