{
	"name": "smeduverse-ai-agent",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n api,web -c blue,green \"bun run dev:api\" \"bun run dev:web\"",
		"dev:api": "bun run --hot api/copilotkit.ts",
		"dev:web": "vite",
		"dev:agent": "bunx @langchain/langgraph-cli dev --host localhost --port 8123",
		"start": "bun run --hot api/copilotkit.ts",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview"
	},
